cursor:pointer}.suggestions button:hover{border-color:#424a56;background:#181c21}.messages{display:grid;gap:20px;padding-bottom:12px}.message{display:flex;gap:12px;max-width:100%}.message.user{justify-content:flex-end}.avatar{flex:0 0 31px;width:31px;height:31px;border-radius:10px;display:grid;place-items:center;font-weight:900;font-size:13px;background:var(--accent);color:#101210}.bubble{max-width:min(720px,85%);border-radius:18px;padding:12px 15px;line-height:1.62;font-size:14px;white-space:pre-wrap;word-break:break-word}.assistant .bubble{background:transparent;padding-top:4px}.user .bubble{background:var(--user);border:1px solid #303640}.meta-row{font-size:10px;color:#737d88;margin-top:8px;display:flex;gap:8px}.verified{color:#bfe956}.typing{display:inline-flex;gap:5px;padding:8px 0}.typing i{width:6px;height:6px;border-radius:50%;background:#89939e;animation:bounce 1s infinite}.typing i:nth-child(2){animation-delay:.14s}.typing i:nth-child(3){animation-delay:.28s}@keyframes bounce{0%,70%,100%{transform:translateY(0);opacity:.5}35%{transform:translateY(-5px);opacity:1}}.composer-wrap{padding:8px max(24px,calc((100% - 840px)/2)) max(13px,env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(13,15,18,0),#0d0f12 18%)}.accuracy-chip{font-size:10px;color:#aeb7c0;margin:0 10px 7px}.composer{display:flex;align-items:flex-end;gap:9px;border:1px solid #333944;background:#171a1f;border-radius:18px;padding:9px 10px;box-shadow:0 14px 45px rgba(0,0,0,.25)}.composer:focus-within{border-color:#596271}.reasoning-select{flex:0 0 auto;height:38px;min-width:88px;max-width:104px;border:1px solid #363d47;border-radius:12px;background:#20242a;color:#eef1f4;padding:0 28px 0 10px;outline:none;font-size:12px;font-weight:900;cursor:pointer;color-scheme:dark}.reasoning-select[data-mode="master"]{border-color:#59683d;background:#20251b;color:#ddff76}.reasoning-select:focus{border-color:#69737f}.reasoning-select:disabled{opacity:.5;cursor:not-allowed}.composer textarea{flex:1;resize:none;max-height:150px;min-height:31px;border:0;outline:0;background:transparent;color:#fff;padding:6px 0;line-height:1.45;min-width:0}.composer textarea::placeholder{color:#6f7883}.send{flex:0 0 38px;width:38px;height:38px;border:0;border-radius:12px;background:var(--accent);color:#111;font-size:22px;font-weight:900;cursor:pointer}.send:disabled{opacity:.35;cursor:not-allowed}.footer-note{text-align:center;color:#626b76;font-size:9px;margin-top:7px}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.58);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:.2s;z-index:40}.overlay.open{opacity:1;pointer-events:auto}.modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-46%);width:min(620px,calc(100% - 30px));background:#15181d;border:1px solid #303640;border-radius:20px;padding:22px;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.2s;z-index:50}.modal.open{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}.modal-head{display:flex;justify-content:space-between;gap:20px}.modal h2{font-size:20px;margin:0 0 4px}.modal-head p{margin:0;color:var(--muted);font-size:12px}.privacy-box{margin:18px 0;padding:11px 12px;border-radius:11px;background:#1e2420;color:#cbe6b4;font-size:11px;line-height:1.5;border:1px solid #32402b}.field-label{display:block;font-size:12px;font-weight:800;margin:0 0 7px}.profile-input{width:100%;height:180px;resize:vertical;border:1px solid #323944;border-radius:13px;background:#0f1115;color:#fff;padding:13px;outline:0;line-height:1.55}.profile-input:focus{border-color:#56606c}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}.primary,.secondary{height:40px;border-radius:11px;padding:0 16px;font-weight:800;cursor:pointer}.primary{border:0;background:var(--accent);color:#111}.secondary{border:1px solid #343b45;background:#1a1e24;color:#d9dfe5}
@media(max-width:800px){.app-shell{grid-template-columns:1fr}.sidebar{position:fixed;inset:0 auto 0 0;width:min(300px,86vw);transform:translateX(-102%);transition:.22s;box-shadow:30px 0 80px rgba(0,0,0,.45)}.sidebar.open{transform:translateX(0)}.mobile-close,.menu-btn{display:block}.topbar{padding:0 12px}.chat{padding:24px 15px 10px}.composer-wrap{padding-left:12px;padding-right:12px}.reasoning-select{min-width:76px;max-width:82px;padding-left:8px;padding-right:20px;font-size:11px}.hero{min-height:calc(100dvh - 250px)}.hero h1{font-size:28px}.hero p{font-size:13px}.suggestions{grid-template-columns:1fr}.suggestions button:nth-child(n+4){display:none}.bubble{max-width:89%}.top-title b{display:none}}
.sources{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}.sources a{max-width:230px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-decoration:none;color:#dce5bd;background:#1c211a;border:1px solid #303a28;border-radius:999px;padding:5px 9px;font-size:10px}.sources a:hover{border-color:#596b45;background:#22291e}

</style>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <div class="brand-wrap">
        <button class="brand" id="brandBtn" aria-label="패밀짐 홈">
          <span class="brand-mark">F</span>
          <span><b>FAMILGYM</b><small>Our Family AI</small></span>
        </button>
        <button class="icon-btn mobile-close" id="closeSidebar" aria-label="메뉴 닫기">×</button>
      </div>

      <button class="new-chat" id="newChatBtn"><span>＋</span> 새 대화</button>

      <div class="side-section">
        <div class="side-label">대화 상대</div>
        <div class="member-list" id="memberList">
          <button class="member active" data-member="가족 공용"><span>🏠</span><span>가족 공용</span></button>
          <button class="member" data-member="나"><span>🙂</span><span>나</span></button>
          <button class="member" data-member="엄마"><span>🌷</span><span>엄마</span></button>
          <button class="member" data-member="아빠"><span>🧢</span><span>아빠</span></button>
        </div>
      </div>

      <div class="side-spacer"></div>

      <button class="side-action" id="familyBtn"><span>👨‍👩‍👧‍👦</span><span>가족 정보</span></button>
      <button class="side-action" id="accuracyBtn"><span>🛡️</span><span>정확도 모드</span><i class="toggle on" id="accuracyToggle"></i></button>
      <div class="status-card" id="statusCard">
        <span class="status-dot"></span>
        <div><b id="statusTitle">연결 확인 중</b><small id="statusDesc">잠시만요</small></div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menuBtn" aria-label="메뉴 열기">☰</button>
        <div class="top-title">
          <b>FAMILGYM</b>
          <span id="memberBadge">가족 공용</span>
        </div>
        <button class="icon-btn" id="topFamilyBtn" aria-label="가족 정보">⚙</button>
      </header>

      <section class="chat" id="chat" aria-live="polite">
        <div class="hero" id="hero">
          <div class="hero-logo">F</div>
          <h1>안녕하세요, <span>패밀짐</span>이에요.</h1>
          <p>우리 가족을 위한 AI. 빠르게 답하고, 한 번 더 확인합니다.</p>
          <div class="suggestions">
            <button data-prompt="오늘 저녁 가족이 같이 할 수 있는 간단한 활동 5개 추천해줘">🏠 가족 활동 추천</button>
            <button data-prompt="초등학생도 이해하게 어려운 내용을 쉽게 설명해줘">📚 쉽게 설명하기</button>
            <button data-prompt="내가 해야 할 일을 보기 좋게 정리해줘">✅ 할 일 정리</button>
            <button data-prompt="이 답변에서 틀릴 가능성이 있는 부분은 따로 표시해줘">🛡️ 정확도 확인</button>
          </div>
        </div>
        <div class="messages" id="messages"></div>
      </section>

      <div class="composer-wrap">
        <div class="accuracy-chip" id="accuracyChip">🛡 정확도 모드 ON · 답변 후 한 번 더 검토</div>
        <form class="composer" id="chatForm">
          <label class="sr-only" for="reasoningMode">추론 수준</label>
          <select class="reasoning-select" id="reasoningMode" aria-label="추론 수준" title="추론 수준">
            <option value="noob">NOOB</option>
            <option value="master">썩은물</option>
          </select>
          <textarea id="prompt" rows="1" placeholder="패밀짐에게 무엇이든 물어보세요" maxlength="10000"></textarea>
          <button type="submit" class="send" id="sendBtn" aria-label="보내기">↑</button>
        </form>
        <div class="footer-note">AI는 실수할 수 있어요. 중요한 정보는 한 번 더 확인하세요.</div>
      </div>
    </main>
  </div>

  <div class="overlay" id="overlay"></div>
  <section class="modal" id="familyModal" role="dialog" aria-modal="true" aria-labelledby="familyTitle">
    <div class="modal-head">
      <div><h2 id="familyTitle">우리 가족 정보</h2><p>패밀짐이 답변할 때 참고할 내용을 직접 적어주세요.</p></div>
      <button class="icon-btn" id="closeModal">×</button>
    </div>
    <div class="privacy-box">🔒 이 정보는 현재 브라우저의 로컬 저장소에 저장됩니다. 서버에는 가족 프로필을 따로 저장하지 않습니다.</div>
    <label class="field-label" for="familyProfile">패밀짐이 기억할 내용</label>
    <textarea class="profile-input" id="familyProfile" placeholder="예) 우리 가족은 4명. 주말에는 가까운 곳으로 나들이하는 걸 좋아함. 엄마는 짧고 핵심적인 답변을 선호함."></textarea>
    <div class="modal-actions">
      <button class="secondary" id="clearProfile">내용 지우기</button>
      <button class="primary" id="saveProfile">저장하기</button>
    </div>
  </section>

  <script>
const $ = (s) => document.querySelector(s);
const $$ = (s) => [...document.querySelectorAll(s)];

const state = {
  member: localStorage.getItem('familgym.member') || '가족 공용',
  familyProfile: localStorage.getItem('familgym.profile') || '',
  accuracyMode: localStorage.getItem('familgym.accuracy') !== 'false',
  reasoningMode: localStorage.getItem('familgym.reasoning') === 'master' ? 'master' : 'noob',
  history: [],
  sending: false,
};

const chat = $('#chat');
const hero = $('#hero');
const messages = $('#messages');
const prompt = $('#prompt');
const sendBtn = $('#sendBtn');
const memberBadge = $('#memberBadge');
const accuracyToggle = $('#accuracyToggle');
const accuracyChip = $('#accuracyChip');
const reasoningMode = $('#reasoningMode');
const API_BASE = (window.FAMILGYM_API_BASE || '').replace(/\/$/, '');
const familyProfile = $('#familyProfile');
const overlay = $('#overlay');
const modal = $('#familyModal');
const sidebar = $('#sidebar');

function escapeHTML(str) {
  return String(str).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}

function formatText(text) {
  let html = escapeHTML(text);
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
  html = html.replace(/\n/g, '<br>');
  return html;
}

function reasoningLabel(mode) {
  return mode === 'master' ? '썩은물' : 'NOOB';
}

function updateUI() {
  memberBadge.textContent = state.member;
  $$('.member').forEach(b => b.classList.toggle('active', b.dataset.member === state.member));
  accuracyToggle.classList.toggle('on', state.accuracyMode);
  reasoningMode.value = state.reasoningMode;
  reasoningMode.dataset.mode = state.reasoningMode;
  accuracyChip.textContent = state.accuracyMode
    ? `🛡 정확도 모드 ON · ${reasoningLabel(state.reasoningMode)} 추론 · 답변 후 한 번 더 검토`
    : `⚡ 정확도 검토 OFF · ${reasoningLabel(state.reasoningMode)} 추론`;
}

function autoResize() {
  prompt.style.height = 'auto';
  prompt.style.height = Math.min(prompt.scrollHeight, 150) + 'px';
}

function addMessage(role, content, meta = {}) {
  hero.style.display = 'none';
  const wrap = document.createElement('div');
  wrap.className = `message ${role}`;
  if (role === 'assistant') {
    const modeBadge = meta.reasoningMode
      ? `<span>🧠 ${reasoningLabel(meta.reasoningMode)}</span>`
      : '';
    wrap.innerHTML = `<div class="avatar">F</div><div class="bubble"><div class="text">${formatText(content)}</div><div class="meta-row">${meta.verified ? '<span class="verified">✓ 2차 검토 완료</span>' : ''}${meta.sources?.length ? '<span>🌐 웹 확인</span>' : ''}${meta.demo ? '<span>데모 모드</span>' : ''}${modeBadge}</div></div>`;
    if (Array.isArray(meta.sources) && meta.sources.length) {
      const sourceWrap = document.createElement('div');
      sourceWrap.className = 'sources';
      for (const source of meta.sources.slice(0, 4)) {
        if (!source?.url || !/^https?:\/\//i.test(source.url)) continue;
        const a = document.createElement('a');
        a.href = source.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = source.title || '출처';
        sourceWrap.appendChild(a);
      }
      wrap.querySelector('.bubble').appendChild(sourceWrap);
    }
  } else {
    wrap.innerHTML = `<div class="bubble">${formatText(content)}</div>`;
  }
  messages.appendChild(wrap);
  chat.scrollTop = chat.scrollHeight;
  return wrap;
}

function addTyping() {
  hero.style.display = 'none';
  const wrap = document.createElement('div');
  wrap.className = 'message assistant';
  wrap.innerHTML = `<div class="avatar">F</div><div class="bubble"><span class="typing"><i></i><i></i><i></i></span></div>`;
  messages.appendChild(wrap);
  chat.scrollTop = chat.scrollHeight;
  return wrap;
}

function localPreviewAnswer(text) {
  const q = text.trim().toLowerCase();
  if (q.includes('안녕')) return '안녕! 나는 패밀짐이야 👋 지금은 공개 미리보기 모드야. 화면과 NOOB/썩은물 추론 선택을 테스트할 수 있어.';
  if ((q.includes('누구') && q.includes('너')) || q.includes('패밀짐')) return '나는 FAMILGYM(패밀짐)이야. 가족이 함께 쓰는 AI로 만들고 있어. 이 공개 주소는 UI 미리보기라 실제 AI 서버 연결은 아직 포함되지 않았어.';
  return `지금 공개 주소는 **UI 데모 모드**야. 선택한 추론 모드는 **${reasoningLabel(state.reasoningMode)}**이고, 실제 AI 서버가 연결되면 이 선택이 답변의 추론 수준에 반영돼.`;
}

async function sendMessage(text) {
  text = text.trim();
  if (!text || state.sending) return;
  state.sending = true;
  sendBtn.disabled = true;
  reasoningMode.disabled = true;
  prompt.value = '';
  autoResize();

  addMessage('user', text);
  const typing = addTyping();

  try {
    const response = await fetch(`${API_BASE}/api/chat`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        message: text,
        member: state.member,
        familyProfile: state.familyProfile,
        accuracyMode: state.accuracyMode,
        reasoningMode: state.reasoningMode,
        history: state.history.slice(-12),
      }),
    });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || '답변을 가져오지 못했어요.');
    typing.remove();
    addMessage('assistant', data.answer || '답변이 비어 있어요.', {
      verified: data.verified,
      demo: data.demo,
      sources: data.sources || [],
      reasoningMode: data.reasoningMode || state.reasoningMode,
    });
    state.history.push({ role:'user', content:text }, { role:'assistant', content:data.answer || '' });
    state.history = state.history.slice(-16);
  } catch (err) {
    typing.remove();
    const answer = localPreviewAnswer(text);
    addMessage('assistant', answer, { demo: true, reasoningMode: state.reasoningMode });
    state.history.push({ role:'user', content:text }, { role:'assistant', content:answer });
    state.history = state.history.slice(-16);
  } finally {
    state.sending = false;
    sendBtn.disabled = false;
    reasoningMode.disabled = false;
    prompt.focus();
  }
}

function resetChat() {
  state.history = [];
  messages.innerHTML = '';
  hero.style.display = 'flex';
  prompt.value = '';
  autoResize();
  closeSidebar();
}

function openFamily() {
  closeSidebar(false);
  familyProfile.value = state.familyProfile;
  modal.classList.add('open');
  overlay.classList.add('open');
  setTimeout(() => familyProfile.focus(), 120);
}

function closeFamily() {
  modal.classList.remove('open');
  if (!sidebar.classList.contains('open')) overlay.classList.remove('open');
}

function closeSidebar(updateOverlay = true) {
  sidebar.classList.remove('open');
  if (updateOverlay && !modal.classList.contains('open')) overlay.classList.remove('open');
}

$('#chatForm').addEventListener('submit', e => { e.preventDefault(); sendMessage(prompt.value); });
prompt.addEventListener('input', autoResize);
prompt.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(prompt.value); }
});

$$('.suggestions button').forEach(b => b.addEventListener('click', () => sendMessage(b.dataset.prompt)));
$$('.member').forEach(b => b.addEventListener('click', () => {
  state.member = b.dataset.member;
  localStorage.setItem('familgym.member', state.member);
  updateUI();
  closeSidebar();
}));

reasoningMode.addEventListener('change', () => {
  state.reasoningMode = reasoningMode.value === 'master' ? 'master' : 'noob';
  localStorage.setItem('familgym.reasoning', state.reasoningMode);
  updateUI();
});

$('#accuracyBtn').addEventListener('click', () => {
  state.accuracyMode = !state.accuracyMode;
  localStorage.setItem('familgym.accuracy', String(state.accuracyMode));
  updateUI();
});
$('#newChatBtn').addEventListener('click', resetChat);
$('#brandBtn').addEventListener('click', resetChat);
$('#familyBtn').addEventListener('click', openFamily);
$('#topFamilyBtn').addEventListener('click', openFamily);
$('#closeModal').addEventListener('click', closeFamily);
overlay.addEventListener('click', () => {
  modal.classList.remove('open');
  sidebar.classList.remove('open');
  overlay.classList.remove('open');
});
$('#saveProfile').addEventListener('click', () => {
  state.familyProfile = familyProfile.value.trim();
  localStorage.setItem('familgym.profile', state.familyProfile);
  closeFamily();
});
$('#clearProfile').addEventListener('click', () => {
  familyProfile.value = '';
  state.familyProfile = '';
  localStorage.removeItem('familgym.profile');
});
$('#menuBtn').addEventListener('click', () => {
  sidebar.classList.add('open');
  overlay.classList.add('open');
});
$('#closeSidebar').addEventListener('click', () => closeSidebar());

document.addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  if (modal.classList.contains('open')) closeFamily();
  else if (sidebar.classList.contains('open')) closeSidebar();
});

async function checkStatus() {
  try {
    const r = await fetch(`${API_BASE}/api/status`, { cache:'no-store' });
    const data = await r.json();
    const dot = $('#statusCard .status-dot');
    if (data.aiConnected) {
      dot.classList.add('live');
      $('#statusTitle').textContent = 'AI 연결됨';
      $('#statusDesc').textContent = `${data.model} · 추론 조절 지원`;
    } else {
      dot.classList.remove('live');
      $('#statusTitle').textContent = '데모 모드';
      $('#statusDesc').textContent = 'AI 키 연결 전';
    }
  } catch {
    $('#statusTitle').textContent = '공개 미리보기';
    $('#statusDesc').textContent = 'UI 데모 · AI 서버 연결 전';
  }
}

updateUI();
autoResize();
checkStatus();

</script>
</body>
</html>
